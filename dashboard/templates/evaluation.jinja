{% extends "base.jinja" %}
{% macro counts(title, groups) %}
{% if groups is mapping and groups %}
<div class="table-wrap">
  <table>
    <caption>{{ title }}</caption>
    <thead><tr><th>名称</th><th>试次</th><th>摔倒</th></tr></thead>
    <tbody>
      {% for name, row in groups.items() if row is mapping %}
      <tr><td>{{ name }}</td><td>{{ row.get('trials', '—') }}</td><td>{{ row.get('falls', '—') }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}
{% endmacro %}
{% block title %}{{ metadata.get('task', item.name) }} · Go2 实验看板{% endblock %}
{% block content %}
<nav class="breadcrumb" aria-label="当前位置">
  <a href="{{ request.url_for('index').path }}">训练实验</a>
  <span aria-hidden="true">/</span>
  <a href="{{ request.url_for('run_detail', run_name=run_name).path }}">{{ run_name }}</a>
</nav>
<section class="page-heading">
  <div>
    <h1>{{ metadata.get('task', item.name) }}</h1>
    <p class="muted">Checkpoint {{ item.iteration }} · {{ date }}{% if metadata.get('backend') %} · {{ metadata.backend }}{% endif %}{% if metadata.get('machine') %} · {{ metadata.machine }}{% endif %}</p>
    <p class="muted directory">{{ item.name }}</p>
  </div>
</section>
<div class="evaluation-layout">
  <section class="panel body-panel">
    <h2>评测回放</h2>
    {% if cases %}
    <form method="get" class="case-select">
      <label for="case">场景 / 工况</label>
      <select id="case" name="case">
        {% for case in cases %}
        <option value="{{ case.name }}"{% if case == selected %} selected{% endif %}>{{ case.name if case.name != '.' else '评测根目录' }}{% if case.video %} · 有回放{% endif %}</option>
        {% endfor %}
      </select>
      <button type="submit">查看</button>
    </form>
    {% endif %}
    {% if selected and selected.video %}
      {% set video_url = request.url_for('artifact', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, kind='video').path ~ '?case=' ~ (selected.name|urlencode) %}
      {% set hls_url = request.url_for('hls_media', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, media_path='master.m3u8').path ~ '?case=' ~ (selected.name|urlencode) %}
      <div class="player" data-video-url="{{ video_url }}"{% if selected.hls %} data-hls-url="{{ hls_url }}"{% endif %}>
        {% if selected.hls %}
          <label>画质
            <select id="video-quality">
              <option value="auto">自动</option>
              <option value="0">省流</option>
              <option value="1">清晰</option>
              <option value="{{ video_url }}">原版 MP4</option>
            </select>
          </label>
        {% elif selected.preview %}
          {% set preview_url = request.url_for('artifact', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, kind='preview').path ~ '?case=' ~ (selected.name|urlencode) %}
          <label>画质
            <select id="video-quality">
              <option value="{{ preview_url }}">低码率预览</option>
              <option value="{{ video_url }}">原版</option>
            </select>
          </label>
        {% endif %}
        <div class="video-frame">
          <video id="replay" controls playsinline preload="none" aria-label="Go2 评测录像"></video>
          <button type="button" class="player-start">播放回放</button>
        </div>
        <p id="playback-status" role="status" hidden></p>
        <button id="retry-video" type="button" hidden>重新连接并续播</button>
        <noscript><a href="{{ video_url }}">打开回放</a></noscript>
      </div>
      {% if selected.hls %}<script defer src="{{ request.url_for('static', path='vendor/hls.min.js').path }}"></script>{% endif %}
      <script defer src="{{ request.url_for('static', path='player.js').path }}"></script>
    {% else %}
      <p class="muted">该工况暂无可播放的回放。</p>
    {% endif %}
  </section>
  <section class="panel body-panel">
    <h2>评测指标</h2>
    {% if totals[0] is not none %}
    <dl class="stats">
      <div><dt>{{ '试次' if report else '套件总试次' }}</dt><dd>{{ totals[0] }}</dd></div>
      <div><dt>{{ '摔倒' if report else '套件总摔倒' }}</dt><dd>{{ totals[1] }}</dd></div>
    </dl>
    {% endif %}
    {% if report_error %}<p class="warning">{{ report_error }}</p>{% endif %}
    {% if not report and not report_error %}<p class="muted">该工况暂无单项报告。</p>{% endif %}
    {% if not has_summary and not cases %}<p class="warning">评测尚未写出结果，或产物目录格式不受支持。</p>{% endif %}
    {% set breakdown = report or summary %}
    {{ counts('按工况', breakdown.get('by_condition')) }}
    {{ counts('按场景', breakdown.get('by_scene')) }}
    {{ counts('按动作组', breakdown.get('groups')) }}
    {% if metadata.get('task') == 'rollout' and breakdown.get('per_case') %}
    <div class="table-wrap">
      <table>
        <caption>Rollout</caption>
        <thead><tr><th>种子</th><th>步数</th><th>重置次数</th><th>平均总奖励</th></tr></thead>
        <tbody>
          {% for row in breakdown.get('per_case') if row is mapping %}
          <tr>
            <td>{{ row.get('seed', '—') }}</td><td>{{ row.get('steps', '—') }}</td>
            <td>{{ row.get('episode_resets', '—') }}</td>
            <td>{{ '%.3f'|format(row.mean_total_reward) if row.mean_total_reward is number else '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% set outcomes = breakdown.get('push_outcomes') %}
    {% if outcomes is mapping and outcomes %}
    <h3>受推结果</h3>
    <dl class="outcomes">
      {% set labels = {'recovered': '恢复', 'not_recovered': '未恢复', 'fell_after_push_onset': '受推后摔倒', 'fell_before_push': '受推前摔倒'} %}
      {% for condition, row in outcomes.items() if row is mapping %}
      <dt>{{ condition }}</dt>
      <dd>{% for result, count in row.items() %}{{ labels.get(result, result) }} {{ count }}{% if not loop.last %} · {% endif %}{% endfor %}</dd>
      {% endfor %}
    </dl>
    {% endif %}
    <div class="report-links">
      {% if selected and selected.assessment %}<a href="{{ request.url_for('artifact', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, kind='assessment').path }}?case={{ selected.name|urlencode }}">逐试次报告 JSON</a>{% endif %}
      {% if has_summary %}<a href="{{ request.url_for('artifact', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, kind='summary').path }}">汇总 JSON</a>{% endif %}
      {% if has_config %}<a href="{{ request.url_for('artifact', run_name=run_name, iteration=item.iteration, evaluation_name=item.name, kind='config').path }}">配置 JSON</a>{% endif %}
    </div>
  </section>
</div>
{% endblock %}
